# Copy to .env and fill in. The Agent SDK reads these from the process
# environment; src/figma_parity/config.py calls load_dotenv() at import so
# this file is what makes them visible.

# Your Anthropic API key. https://platform.claude.com/
ANTHROPIC_API_KEY=

# Directories this service is permitted to write into, os.pathsep-separated.
# THIS IS THE TRUST BOUNDARY. project_path arrives over HTTP and is handed to
# an agent running with acceptEdits and Bash. An empty value refuses everything.
FIGMA_PARITY_ALLOWED_ROOTS=/Users/mahdikhorshidi/Documents/Projects

# Server bind. Localhost only by design — this process holds your API key and
# can execute code. Do not bind 0.0.0.0 without adding authentication.
FIGMA_PARITY_HOST=127.0.0.1
FIGMA_PARITY_PORT=8787

# Agent knobs
FIGMA_PARITY_MODEL=claude-opus-5
FIGMA_PARITY_EFFORT=xhigh
FIGMA_PARITY_MAX_ITERATIONS=5
# Hard spend ceiling per run, in USD. This runs on your credits.
FIGMA_PARITY_MAX_BUDGET_USD=5.0

# Parity knobs. A text-heavy UI never diffs to 0.00% — Figma's rasterizer and
# a browser's disagree on antialiasing. Raise TOL if text noise dominates.
FIGMA_PARITY_TOL=12
FIGMA_PARITY_THRESHOLD_PCT=0.5
